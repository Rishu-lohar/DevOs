generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum ProjectMemberRole {
  OWNER
  MANAGER
  DEVELOPER
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REJECTED
  EXPIRED
}

enum TaskDependencyType {
  BLOCKS
  DEPENDS_ON
}

enum MilestoneStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  LATE
}

enum ActivityType {
  PROJECT_CREATED
  PROJECT_UPDATED
  TASK_CREATED
  TASK_UPDATED
  TASK_COMPLETED
  TASK_DELETED
  MEMBER_ADDED
  MEMBER_REMOVED
  INVITATION_SENT
  AI_GENERATED
  SYSTEM
}

enum NotificationType {
  TASK
  PROJECT
  INVITATION
  MILESTONE
  AI
  SYSTEM
}

enum AIExecutionStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
}

model User {
  id            String   @id @default(cuid())
  supabaseId    String?  @unique
  name          String
  email         String   @unique
  avatarUrl     String?
  jobTitle      String?
  skills        String[] @default([])
  createdAt     DateTime @default(now())

  projects            Project[]
  projectMemberships  ProjectMember[]
  tasks               Task[]
  assignedTasks       Task[] @relation("TaskAssignee")
  conversations       Conversation[]
  invitationsSent     Invitation[] @relation("InvitationInvitedBy")
  invitationsReceived Invitation[] @relation("InvitationInvitedUser")
  milestones          Milestone[] @relation("MilestoneCreatedBy")
  notifications       Notification[]
  activityLogs        ActivityLog[]
  documents           ProjectDocument[]
  aiExecutions        AIExecution[]
}

model Project {
  id          String   @id @default(cuid())
  name        String
  description String?
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tasks         Task[]
  members       ProjectMember[]
  invitations  Invitation[]
  milestones   Milestone[]
  activityLogs ActivityLog[]
  notifications Notification[]
  documents    ProjectDocument[]
  aiExecutions  AIExecution[]

  @@index([userId, createdAt])
}

model ProjectMember {
  id        String            @id @default(cuid())
  projectId  String
  userId    String
  role      ProjectMemberRole @default(DEVELOPER)
  createdAt DateTime          @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([projectId, role])
  @@index([userId])
}

model Invitation {
  id           String          @id @default(cuid())
  projectId    String
  email        String
  role         ProjectMemberRole @default(DEVELOPER)
  status       InvitationStatus @default(PENDING)
  invitedById  String
  invitedUserId String?
  expiresAt    DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  project      Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  invitedBy    User    @relation("InvitationInvitedBy", fields: [invitedById], references: [id], onDelete: Cascade)
  invitedUser  User?   @relation("InvitationInvitedUser", fields: [invitedUserId], references: [id], onDelete: SetNull)

  @@unique([projectId, email])
  @@index([email, status])
  @@index([invitedById])
}

model Task {
  id          String    @id @default(cuid())
  title       String
  description String?
  status      String    @default("TODO")
  priority    String?
  estimate    Int?
  dueDate     DateTime?
  completed   Boolean   @default(false)
  createdAt   DateTime  @default(now())

  projectId    String
  project      Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  userId       String
  user         User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  assigneeId   String?
  assignee     User?  @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  milestoneId  String?
  milestone    Milestone? @relation(fields: [milestoneId], references: [id], onDelete: SetNull)

  dependsOn    TaskDependency[] @relation("TaskDependencySource")
  dependents   TaskDependency[] @relation("TaskDependencyTarget")
  notifications Notification[]
  activityLogs ActivityLog[]

  @@index([projectId, status])
  @@index([userId, status])
  @@index([assigneeId, status])
  @@index([projectId, dueDate])
}

model TaskDependency {
  id               String            @id @default(cuid())
  taskId           String
  dependsOnTaskId  String
  type             TaskDependencyType @default(BLOCKS)
  createdAt        DateTime          @default(now())

  task            Task @relation("TaskDependencySource", fields: [taskId], references: [id], onDelete: Cascade)
  dependsOnTask   Task @relation("TaskDependencyTarget", fields: [dependsOnTaskId], references: [id], onDelete: Cascade)

  @@unique([taskId, dependsOnTaskId])
  @@index([taskId])
  @@index([dependsOnTaskId])
}

model Milestone {
  id          String         @id @default(cuid())
  projectId   String
  createdById String
  title       String
  description String?
  dueDate     DateTime?
  status      MilestoneStatus @default(PLANNED)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  project    Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy  User    @relation("MilestoneCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  tasks      Task[]

  @@index([projectId, status])
  @@index([createdById])
}

model ActivityLog {
  id        String      @id @default(cuid())
  projectId  String?
  taskId    String?
  userId    String?
  type      ActivityType
  message   String
  metadata  Json?
  createdAt DateTime    @default(now())

  project Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task    Task?    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user    User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([projectId, createdAt])
  @@index([userId, createdAt])
  @@index([taskId])
}

model Notification {
  id        String          @id @default(cuid())
  userId    String
  projectId String?
  taskId    String?
  type      NotificationType
  title     String
  message   String
  readAt    DateTime?
  createdAt DateTime        @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task      Task?    @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
  @@index([projectId])
}

model ProjectDocument {
  id          String   @id @default(cuid())
  projectId   String
  uploadedById String
  name        String
  fileUrl     String
  mimeType    String?
  sizeBytes   Int?
  createdAt   DateTime @default(now())

  project      Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  uploadedBy   User    @relation(fields: [uploadedById], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
  @@index([uploadedById])
}

model AIExecution {
  id        String          @id @default(cuid())
  userId    String
  projectId String?
  type      String
  prompt    String
  response  String?
  status    AIExecutionStatus @default(QUEUED)
  metadata  Json?
  createdAt DateTime         @default(now())
  finishedAt DateTime?

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([projectId, createdAt])
}

model Conversation {
  id        String   @id @default(cuid())
  title     String   @default("New chat")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  messages Message[]
}

model Message {
  id             String   @id @default(cuid())
  role           String
  content        String
  createdAt      DateTime @default(now())

  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
}